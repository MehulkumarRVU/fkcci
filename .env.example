# Copy this file to .env and edit for your environment
# IMPORTANT: replace SECRET_KEY with a strong random value in production
SECRET_KEY=change-me-to-a-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./pocketcoach.db
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# If you run Redis, set REDIS_URL to something like redis://localhost:6379/0
REDIS_URL=
