# Copy this file to .env. Keep real credentials out of version control.
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
DATABASE_URL=sqlite:///./pocketcoach.db
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=pocketcoach:rl
# Redis is optional for local Python development; Docker Compose uses its Redis service.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_RETRY_INTERVAL_SECONDS=5
# Required by Docker Compose PostgreSQL. Use a URL-safe password (letters/numbers).
POSTGRES_USER=pocketcoach
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_DB=pocketcoach
# PostgreSQL maintenance profile; store backups outside the repository in production.
BACKUP_STORAGE_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
# Optional HTTPS-only webhook for a safe backup failure notification. Never use a URL containing credentials.
# BACKUP_FAILURE_WEBHOOK_URL=https://monitor.example.com/hooks/backup-failures
# Optional: restrict allowed frontend origins for CORS
# Must be valid JSON array syntax so pydantic can parse it from .env files.
CORS_ALLOWED_ORIGINS=["http://localhost","http://localhost:3000","http://127.0.0.1:3000"]
# Optional PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/pocketcoach
ENV=development

# Password reset email delivery. Production requires SMTP_HOST and SMTP_FROM_EMAIL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password-or-app-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=10
# Base URL the frontend is served from - used to build the reset link sent by email
FRONTEND_BASE_URL=http://localhost:3000
