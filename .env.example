# Copy this file to .env and edit for your environment
# IMPORTANT: replace SECRET_KEY with a strong random value in production
SECRET_KEY=replace-with-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./pocketcoach.db
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Optional: use Redis for distributed rate limiting
REDIS_URL=redis://localhost:6379/0
# Optional: restrict allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=*
# Optional PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/pocketcoach
ENV=development
